<view class="page safe-bottom"><view class="title">{{id?'岗位详情':'新增岗位'}}</view><view class="subtitle">选择实际工作单位并上传视频，职业类别由平台确定</view>
  <view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:else>
    <view class="card section"><label class="field"><view class="field-label required">实际工作单位</view><picker range="{{employers}}" range-key="name" value="{{employerIndex}}" bindchange="employerChange"><view class="picker">{{employers[employerIndex].name||'请先新增实际工作单位'}}</view></picker></label><label class="field"><view class="field-label required">岗位名称</view><input class="input" value="{{form.name}}" data-key="name" bindinput="input" placeholder="如：仓储分拣员" /></label><label class="field"><view class="field-label">意向保司产品</view><picker range="{{plans}}" range-key="name" value="{{planIndex}}" bindchange="planChange"><view class="picker">{{plans[planIndex].name}}{{plans[planIndex].insurer?'  ·  '+plans[planIndex].insurer:''}}</view></picker></label><view class="field"><view class="field-label">职业类别</view><view class="picker">{{item.occupation_class||'待平台定类'}}（仅平台可操作）</view></view><view class="field"><view class="field-label">扫码参保</view><view class="row between" style="margin-bottom:12rpx"><view><view>个人缴纳</view><view class="small">员工扫码自己付费参保</view></view><switch checked="{{form.enable_personal_pay}}" data-key="enable_personal_pay" bindchange="toggle" /></view><view class="row between"><view><view>单位缴纳</view><view class="small">员工扫码登记，费用由单位承担</view></view><switch checked="{{form.enable_employer_pay}}" data-key="enable_employer_pay" bindchange="toggle" /></view></view><button class="primary" loading="{{saving}}" disabled="{{saving||!employers.length}}" bindtap="save">{{id?'保存岗位信息':'创建岗位并上传视频'}}</button></view>
    <view class="card"><view class="row between"><view><view class="section-title">岗位视频</view><view class="small">请拍摄真实工作环境，单个不超过100MB；上传时请保持页面开启</view></view><text class="tag {{item.status==='approved'?'tag-success':'tag-warning'}}">{{item?item.status_label:'待上传'}}</text></view><view class="divider"></view><view wx:for="{{videos}}" wx:key="id" class="row between" style="margin-bottom:18rpx"><view class="grow"><view class="ellipsis">{{item.name}}</view><view class="small">{{item.status_label}} {{item.review_note}}</view></view><text class="tag {{item.status==='approved'?'tag-success':item.status==='rejected'?'tag-danger':'tag-warning'}}">{{item.status_label}}</text></view><button class="secondary" loading="{{uploading}}" disabled="{{!id||!item||uploading}}" bindtap="uploadVideo">{{uploading?'视频上传中，请稍候':'拍摄 / 选择岗位视频'}}</button></view>
    <view wx:if="{{item&&item.status==='approved'&&(form.enable_personal_pay||form.enable_employer_pay)}}" class="card"><view class="section-title">参保二维码</view><view class="small">员工用微信扫码即可填写姓名和身份证号提交参保，提交后经平台审核生效。开关改动保存后二维码才会更新。</view><view class="divider"></view>
      <view wx:if="{{qrLoading}}" class="loading">二维码加载中…</view>
      <block wx:else>
        <view wx:if="{{qr&&qr.personal&&qr.personal.enabled}}" style="text-align:center;margin-bottom:24rpx"><view class="small" style="margin-bottom:8rpx">个人缴纳</view><image src="data:image/png;base64,{{qr.personal.qr_base64}}" mode="widthFix" style="width:360rpx" data-mode="personal" bindtap="saveQr" /><view class="small">点击二维码保存到相册</view></view>
        <view wx:if="{{qr&&qr.employer&&qr.employer.enabled}}" style="text-align:center;margin-bottom:24rpx"><view class="small" style="margin-bottom:8rpx">单位缴纳</view><image src="data:image/png;base64,{{qr.employer.qr_base64}}" mode="widthFix" style="width:360rpx" data-mode="employer" bindtap="saveQr" /><view class="small">点击二维码保存到相册</view></view>
        <button class="secondary" bindtap="regenerateQr">重新生成二维码（旧码作废）</button>
      </block>
    </view>
    <view wx:if="{{item&&item.status!=='approved'}}" class="card notice">岗位当前不可用于新增参保。视频上传后请等待平台审核并确定职业类别。</view>
  </view>
</view>
